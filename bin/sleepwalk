#!/bin/bash
# Hands busy Claude Code sessions to Claude Code on the web when the Mac sleeps, and
# brings them back when it wakes. See README.md.
#
# Usage: sleepwalk <command> [args...]   (sleepwalk help for the list)
#
# Written for the bash 3.2 that ships with macOS: no associative arrays or mapfile.
set -u

HANDOFF_HOME="${SLEEPWALK_HOME:-$HOME/.claude/sleepwalk}"
SESSIONS="$HANDOFF_HOME/sessions"
LOG="$HANDOFF_HOME/handoff.log"
CONFIG="$HANDOFF_HOME/config"
CLAUDE_SETTINGS="${SLEEPWALK_SETTINGS:-$HOME/.claude/settings.json}"
LABEL="com.github.swperb.sleepwalk"
PLIST="${SLEEPWALK_PLIST:-$HOME/Library/LaunchAgents/$LABEL.plist}"

# Defaults. Override any of them in $CONFIG, which is sourced as shell, or in the
# environment.
TRIGGER="${TRIGGER:-lid}"       # lid: hand off only when the lid is closed; any: on every sleep
SCOPE="${SCOPE:-busy}"        # busy: sessions in the middle of a turn; recent: idle ones too
RECENT_MINUTES="${RECENT_MINUTES:-30}" # how recent an idle session's activity must be for SCOPE=recent
STALE_MINUTES="${STALE_MINUTES:-20}" # a "busy" session quiet for longer than this is treated as idle
SLEEP_BUDGET="${SLEEP_BUDGET:-22}"   # seconds the sleep step may take; macOS forces sleep at about 30
INCLUDE_UNTRACKED="${INCLUDE_UNTRACKED:-1}" # commit untracked, non-ignored files in the handoff commit
MAX_FILE_MB="${MAX_FILE_MB:-50}"    # leave files bigger than this out of the handoff commit (GitHub refuses 100 MB)
AUTO_RESUME="${AUTO_RESUME:-1}"     # on wake, open a terminal that teleports the session back
WRAPUP_WAIT="${WRAPUP_WAIT:-45}"    # most seconds to give the cloud session to push before teleporting
PUSH_QUIET="${PUSH_QUIET:-8}"       # teleport once the cloud branch has moved and then stayed still this long
NETWORK_WAIT="${NETWORK_WAIT:-120}"  # seconds to wait for the network after waking
TERMINAL_APP="${TERMINAL_APP:-Terminal}" # the app that opens the resume .command file (Terminal, iTerm)
BRIEF_CHARS="${BRIEF_CHARS:-12000}" # size limit for the conversation excerpt in the cloud brief
HOTSPOT_SSID="${HOTSPOT_SSID:-}" # Wi-Fi to join when there is no network at sleep or wake (an iPhone hotspot)
HOTSPOT_WAIT="${HOTSPOT_WAIT:-10}" # seconds to wait for the network after joining it
PRUNE_DAYS="${PRUNE_DAYS:-7}"     # forget sessions with no activity for this many days
RESUMED_KEEP_HOURS="${RESUMED_KEEP_HOURS:-24}" # forget a session this long after it was teleported back
LOG_MAX_KB="${LOG_MAX_KB:-1024}"  # past this size a log moves to <log>.1 and starts afresh
DEBUG="${DEBUG:-0}"           # 1: log every hook event (to see which events Claude Code sends)
CLAUDE_BIN="${CLAUDE_BIN:-}"
CLAUDE_CONFIG_FILE="${CLAUDE_CONFIG_FILE:-$HOME/.claude.json}"
NETWORKSETUP="${NETWORKSETUP:-/usr/sbin/networksetup}"  # where Claude Code keeps folder trust
# shellcheck source=/dev/null
[ -f "$CONFIG" ] && . "$CONFIG"

# sleepwalk simulate writes this file for the length of a rehearsal. It makes the lid read
# as closed, the network as down, or narrows which sessions are handed off. It is ignored
# once it is half an hour old, so a rehearsal that dies cannot leave it in force.
SIMULATE="$HANDOFF_HOME/simulate"
SIM_LID="" SIM_OFFLINE_UNTIL=0 SIM_ONLY="" SIM_SKIP=""
# shellcheck source=/dev/null
if [ -f "$SIMULATE" ] && [ -z "$(find "$SIMULATE" -mmin +30 2>/dev/null)" ]; then . "$SIMULATE"; fi

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

WRAPUP_MSG='The user has opened their laptop again and will continue this session there. Stop starting new work. Commit everything (if tests fail, say so in the commit message) and push the branch. Then end with a short summary for the user: what you did, what is left, and any decisions you made for them.'

die() { echo "sleepwalk: $*" >&2; exit 1; }

log() {
  mkdir -p "$HANDOFF_HOME"
  rotate_log "$LOG"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
}

# rotate_log <file>: once the file passes LOG_MAX_KB, keeps it as <file>.1 and empties
# it. Copies and truncates rather than moving, so a process that holds the log open
# (launchd's sleepwatch.log) carries on writing to the fresh one.
rotate_log() {
  local size
  size="$(stat -f %z "$1" 2>/dev/null)" || return 0
  [ "$size" -gt $((LOG_MAX_KB * 1024)) ] || return 0
  cp "$1" "$1.1" 2>/dev/null && : > "$1"
}

now() { date +%s; }

# Temporary files, lock folders and child processes to clean up however the script ends.
# The traps are set once, here, and read only these globals: a trap that names a
# function's local variable fails under set -u once the function has returned.
CLEANUP_PATHS=""
CLEANUP_PIDS=""
cleanup_add() { CLEANUP_PATHS="$CLEANUP_PATHS$1
"; }
# stop_pid <pid>: stops a process and everything under it. A whole tree, because
# expect(1) runs claude in a session of its own that does not always die with expect.
stop_pid() {
  local c
  kill -STOP "$1" 2>/dev/null   # so it starts nothing new while its children go
  for c in $(pgrep -P "$1" 2>/dev/null); do stop_pid "$c"; done
  kill "$1" 2>/dev/null; kill -CONT "$1" 2>/dev/null
}
cleanup() {
  local p
  for p in $CLEANUP_PIDS; do stop_pid "$p"; done
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if [ -d "$p" ]; then rm -f "$p/pid"; rmdir "$p" 2>/dev/null; else rm -f "$p"; fi
  done <<EOF
$CLEANUP_PATHS
EOF
  CLEANUP_PATHS=""; CLEANUP_PIDS=""
}
trap cleanup EXIT
trap 'exit 1' TERM INT   # exit runs the EXIT trap
# A closed Terminal window sends HUP. While claude --teleport runs, resume sets
# KEEP_ON_HUP=1 so it can still record how the teleport went.
KEEP_ON_HUP=0
trap '[ "$KEEP_ON_HUP" = 1 ] || exit 1' HUP

claude_bin() {
  if [ -n "$CLAUDE_BIN" ]; then echo "$CLAUDE_BIN"; return; fi
  command -v claude 2>/dev/null && return
  [ -x "$HOME/.local/bin/claude" ] && { echo "$HOME/.local/bin/claude"; return; }
  die "claude is not on PATH; set CLAUDE_BIN in $CONFIG"
}

rec() { echo "$SESSIONS/$1.json"; }

# update_rec <session-id> [jq options...] <filter>: applies a jq filter to the session's
# record, creating it if needed. Writes through a temporary file so readers never see a
# half-written record, and holds a lock so that a hook and a handoff writing at the same
# moment cannot undo each other's change. A missing, empty or unreadable record starts
# afresh; a failed write leaves the record as it was.
update_rec() {
  local f tmp lock i=0 rc=0
  f="$(rec "$1")"; shift
  mkdir -p "$SESSIONS"
  tmp="$f.$$.tmp"; lock="$f.lock"
  # Wait up to about two seconds; a lock older than that was left by a process that died.
  until mkdir "$lock" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -ge 20 ] && { rmdir "$lock" 2>/dev/null; mkdir "$lock" 2>/dev/null; break; }
    sleep 0.1
  done
  if [ -s "$f" ] && jq "$@" "$f" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then :
  elif jq -n "$@" > "$tmp" && [ -s "$tmp" ]; then :
  else rc=1; fi
  if [ "$rc" = 0 ]; then mv "$tmp" "$f" || rc=1; fi
  rm -f "$tmp"
  rmdir "$lock" 2>/dev/null
  return "$rc"
}

field() { jq -r "$2 // empty" "$1" 2>/dev/null; }

lid_closed() {
  [ -n "${SLEEPWALK_LID:-}" ] && { [ "$SLEEPWALK_LID" = closed ]; return; }
  [ -n "$SIM_LID" ] && { [ "$SIM_LID" = closed ]; return; }
  ioreg -r -k AppleClamshellState -d 4 2>/dev/null | grep -q '"AppleClamshellState" = Yes'
}

# A handed-off session stays paused locally until it is resumed or released, so that the
# cloud agent and the local one never edit the same tree at once.
is_paused_status() {
  case "$1" in cloud|returning|resumed) return 0 ;; *) return 1 ;; esac
}

paused_reason() {
  local sid="$1" status="$2" url="$3"
  case "$status" in
    resumed)
      printf 'This session was handed off to Claude Code on the web while the Mac slept (%s) and has since been brought back into a new local session with claude --teleport. This copy is out of date and is paused. Run `sleepwalk release %s` to use it anyway.' "$url" "$sid" ;;
    *)
      printf 'This session was handed off to Claude Code on the web while the Mac slept (%s), and its work continues there. This local copy is paused so two agents never edit the same tree. Stop and tell the user. To continue locally, run `sleepwalk resume %s` (pulls the cloud conversation back with claude --teleport), or `sleepwalk release %s` to drop the handoff and use this copy.' "$url" "$sid" "$sid" ;;
  esac
}

# --- folder trust -------------------------------------------------------------------
# Interactive Claude Code trusts a folder when the folder or any folder above it is
# trusted. Creating a cloud session checks the folder itself, so a folder trusted only
# through a parent asks "do you trust this folder?" at the worst moment, with the lid
# closing. Sleepwalk never answers that prompt. Instead it asks the user about such
# folders at session start (trust_hint), and records trust only when they agree
# (sleepwalk trust). A handoff that meets the prompt fails at once and is rolled back.

# trust_of <folder>: prints "exact" when Claude Code trusts the folder itself,
# "parent:<folder>" when it trusts only an enclosing folder, and nothing otherwise.
trust_of() {
  jq -r --arg d "$1" '
    (.projects // {}) as $p
    | if (($p[$d] | type) == "object" and $p[$d].hasTrustDialogAccepted == true) then "exact"
      else ([$p | to_entries[]
              | select((.value | type) == "object" and .value.hasTrustDialogAccepted == true)
              | .key | select(. as $k | $d | startswith($k + "/"))] | max_by(length)) as $parent
        | if $parent then "parent:" + $parent else empty end
      end' "$CLAUDE_CONFIG_FILE" 2>/dev/null
}

# At session start, in a repository trusted only through a parent, asks Claude (once per
# folder) to check with the user whether to record trust for the folder itself.
trust_hint() {
  local d="$1" t marker
  [ -n "$d" ] || return 0
  git -C "$d" remote get-url origin >/dev/null 2>&1 || return 0
  t="$(trust_of "$d")"
  case "$t" in parent:*) ;; *) return 0 ;; esac
  marker="$HANDOFF_HOME/trust-asked/$(printf '%s' "$d" | shasum | cut -c1-16)"
  [ -f "$marker" ] && return 0
  mkdir -p "$HANDOFF_HOME/trust-asked" && : > "$marker"
  printf '%s\n' "Sleepwalk: Claude Code trusts $d only through ${t#parent:}. Creating a cloud session checks the folder itself, so Sleepwalk cannot hand this session to the cloud when the lid closes until $d is trusted on its own. Ask the user once, briefly, whether to record trust for $d now. If they agree, run: sleepwalk trust \"$d\""
}

# sleepwalk trust <folder>: records Claude Code trust for exactly this folder, as answering
# Yes to its trust prompt would. Run it only when the user has agreed.
cmd_trust() {
  local d tmp
  [ $# -ge 1 ] || die "usage: sleepwalk trust <folder>"
  d="$(cd "$1" 2>/dev/null && pwd)" || die "no such folder: $1"
  [ "$(trust_of "$d")" = exact ] && { echo "Claude Code already trusts $d."; return 0; }
  [ -f "$CLAUDE_CONFIG_FILE" ] || die "$CLAUDE_CONFIG_FILE not found; start claude once first"
  cp -p "$CLAUDE_CONFIG_FILE" "$CLAUDE_CONFIG_FILE.bak-sleepwalk"
  tmp="$CLAUDE_CONFIG_FILE.sleepwalk.$$"
  jq --arg d "$d" '.projects = (.projects // {})
    | .projects[$d] = ((.projects[$d] // {}) | if type == "object" then . else {} end)
    | .projects[$d].hasTrustDialogAccepted = true' "$CLAUDE_CONFIG_FILE" > "$tmp" \
    && chmod 600 "$tmp" && mv "$tmp" "$CLAUDE_CONFIG_FILE" \
    || { rm -f "$tmp"; die "could not update $CLAUDE_CONFIG_FILE (backup at $CLAUDE_CONFIG_FILE.bak-sleepwalk)"; }
  log "recorded Claude Code trust for $d"
  echo "Claude Code now trusts $d (recorded in $CLAUDE_CONFIG_FILE; backup alongside it)."
}

# --- hook ---------------------------------------------------------------------------
# Claude Code runs this for SessionStart, UserPromptSubmit, PreToolUse, Stop and
# SessionEnd. It keeps a record of each session's state, and blocks a paused session.
#
# A subagent's tool calls arrive with its parent's session_id, plus agent_id and
# agent_type, and with the subagent's own cwd (a .claude/worktrees/agent-* checkout when
# it runs isolated in a worktree). They show the session is alive, but they must not move
# its folder or change its state, or a lid close would hand off the subagent's worktree as
# the session. Their folders are kept in .worktrees so a handoff can report leftover work.
cmd_hook() {
  local input sid event cwd transcript agent f status url t main
  input="$(cat)"
  # Split on the unit separator, not a tab: read collapses empty tab-separated fields,
  # which would shift the ones after them.
  IFS=$'\037' read -r sid event cwd transcript agent <<EOF
$(printf '%s' "$input" | jq -r '[.session_id, .hook_event_name, .cwd, .transcript_path, .agent_id] | map(. // "" | tostring) | join("\u001f")' 2>/dev/null)
EOF
  [ -n "${sid:-}" ] || return 0
  # Sleepwalk's own claude calls (creating and messaging cloud sessions) run with
  # SLEEPWALK_INTERNAL set, and are not sessions to track.
  [ -n "${SLEEPWALK_INTERNAL:-}" ] && return 0
  [ "$DEBUG" = 1 ] && log "hook $event $sid"
  f="$(rec "$sid")"
  status=""; url=""
  if [ -f "$f" ]; then
    status="$(field "$f" .handoff.status)"
    url="$(field "$f" .handoff.url)"
  fi
  t="$(now)"

  if is_paused_status "$status"; then
    case "$event" in
      UserPromptSubmit)
        jq -n --arg r "$(paused_reason "$sid" "$status" "$url")" '{decision: "block", reason: $r}' ;;
      PreToolUse)
        jq -n --arg r "$(paused_reason "$sid" "$status" "$url")" \
          '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}' ;;
    esac
    return 0
  fi

  # Older Claude Code versions may not send agent_id. A tool call from inside an Agent
  # tool worktree of the session's own folder is a subagent's too.
  if [ -z "$agent" ] && [ -f "$f" ]; then
    main="$(field "$f" .cwd)"
    case "$event:$cwd" in
      PreToolUse:"$main"/.claude/worktrees/agent-*|Stop:"$main"/.claude/worktrees/agent-*)
        [ -n "$main" ] && agent=worktree ;;
    esac
  fi
  if [ -n "$agent" ]; then
    # The parent's own Agent tool call creates the record first. Without one there is no
    # main folder to keep, so nothing is recorded.
    [ -f "$f" ] || return 0
    update_rec "$sid" --arg cwd "$cwd" --argjson t "$t" '.last_activity = $t
      | if $cwd != "" and $cwd != .cwd
        then .worktrees = ((((.worktrees // []) - [$cwd]) + [$cwd]) | .[-20:]) else . end'
    return 0
  fi

  case "$event" in
    SessionStart)
      # Shown to Claude at session start, so it can tell the user setup is unfinished.
      [ -f "$PLIST" ] || echo "Sleepwalk is enabled but its sleep watcher is not installed, so nothing will be handed off when the lid closes. Suggest the user run /sleepwalk:install."
      trust_hint "$cwd"
      update_rec "$sid" --arg sid "$sid" --arg cwd "$cwd" --arg tp "$transcript" --argjson t "$t" \
        '.session_id = $sid | .cwd = $cwd | .transcript_path = $tp | .state = (.state // "idle") | .last_activity = $t'
      maybe_prune ;;
    UserPromptSubmit|PreToolUse)
      update_rec "$sid" --arg sid "$sid" --arg cwd "$cwd" --arg tp "$transcript" --argjson t "$t" \
        '.session_id = $sid | .cwd = $cwd | .transcript_path = $tp | .state = "busy" | .last_activity = $t' ;;
    Stop)
      update_rec "$sid" --arg sid "$sid" --arg cwd "$cwd" --arg tp "$transcript" --argjson t "$t" \
        '.session_id = $sid | .cwd = $cwd | .transcript_path = $tp | .state = "idle" | .last_activity = $t' ;;
    SessionEnd)
      rm -f "$f" "$HANDOFF_HOME/resume-$sid.command" ;;
  esac
  return 0
}

# --- brief --------------------------------------------------------------------------
# Builds the cloud agent's instructions from the session transcript (Claude Code's JSONL;
# a half-written last line is skipped): the original request, the recent conversation,
# the latest task list, and the last tool calls with whether each one finished. Sleepwalk's
# own SessionStart notes, and Claude's replies relaying them, are left out: they are about
# the laptop and mean nothing in the cloud. The whole excerpt stays within BRIEF_CHARS.
# shellcheck disable=SC2016 # a jq program, not shell
BRIEF_JQ='
def clip($n): if length > $n then .[0:$n - 3] + "..." else . end;
def oneline: gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "");
def ownnote: test("sleepwalk trust|/sleepwalk:install|sleep watcher is not installed|^\\s*Sleepwalk:"; "i");
def texts: (if type == "string" then [.] else [.[]? | select(.type == "text") | .text] end)
  | map(select(test("^\\s*<") | not) | split("\n\n") | map(select(ownnote | not)) | join("\n\n"))
  | join("\n");
def rawtext: if type == "string" then . elif type == "array" then [.[]? | select(.type? == "text") | .text] | join("\n") else "" end;
def listtool: .name | test("^(TodoWrite|TaskCreate|TaskUpdate|mcp__ccd_turn__update_plan)$");
def hidden: listtool or (.name | test("^(TaskList|TaskGet|mcp__ccd_(turn|session)__.*)$"));
def summary: (.input // {}) as $i
  | (if .name == "Bash" then ($i.command // "" | tostring) + (if $i.run_in_background == true then " (in the background)" else "" end)
     elif ($i.file_path // $i.notebook_path) then ($i.file_path // $i.notebook_path)
     elif $i.pattern then ($i.pattern | tostring) + (if $i.path then " in \($i.path)" else "" end)
     elif ($i.url // $i.query // $i.description // $i.skill) then ($i.url // $i.query // $i.description // $i.skill)
     elif $i == {} then ""
     else $i end) | tostring | oneline | clip(150);

[inputs | fromjson? | objects] as $all
| [$all[] | select((.type == "user" or .type == "assistant") and (.isSidechain != true))] as $chain
| [$chain[] | select(.isMeta != true)
    | {who: (if .type == "user" then "USER" else "CLAUDE" end), text: (.message.content | texts)}
    | select(.text | test("\\S"))] as $m
| [$chain[] | select(.type == "assistant") | .message.content[]? | select(.type? == "tool_use")] as $calls
| (reduce ($chain[] | select(.type == "user") | . as $e | .message.content[]? | select(.type? == "tool_result")
      | {id: .tool_use_id, err: (.is_error == true), text: (.content | rawtext), extra: $e.toolUseResult})
    as $r ({}; .[$r.id] = $r)) as $res
| (reduce ($all[] | .message.content?, .content?, .attachment.prompt? | rawtext
      | scan("<task-notification>[\\s\\S]*?</task-notification>"))
    as $n ({}; ([$n | capture("<tool-use-id>(?<id>[^<]+)</tool-use-id>").id] | first) as $id
      | if $id then .[$id] = ([$n | capture("<status>(?<s>[^<]+)</status>").s] | first // "finished") else . end)) as $bg
| (reduce ($calls[] | select(listtool) | select(($res[.id].err // false) | not)) as $c ([];
    ($c.input // {}) as $in
    | if $c.name == "TodoWrite" then [$in.todos[]? | {content, status}]
      elif $c.name == "TaskCreate" then
        . + [{id: (([$res[$c.id].extra.task.id?] | first)
                   // ([$res[$c.id].text // "" | capture("#(?<n>[0-9]+)").n] | first)
                   // (length + 1)) | tostring,
              content: $in.subject, status: "pending"}]
      elif $c.name == "TaskUpdate" then
        map(if .id == ($in.taskId | tostring)
            then (if $in.status then .status = $in.status else . end)
               | (if $in.subject then .content = $in.subject else . end)
            else . end) | map(select(.status != "deleted"))
      elif $in.items then [$in.items[]? | {content, status}]
      else
        (if $in.advance == true then
           ([to_entries[] | select(.value.status == "in_progress") | .key] | first) as $i
           | (if $i != null then .[$i].status = "completed" else . end)
           | ([to_entries[] | select(.value.status == "pending") | .key] | first) as $j
           | (if $j != null then .[$j].status = "in_progress" else . end)
         else . end)
        | reduce ($in.done // [])[] as $d (.; if $d >= 1 and $d <= length then .[$d - 1].status = "completed" else . end)
        | (($in.start // 0) as $s | if $s >= 1 and $s <= length then .[$s - 1].status = "in_progress" else . end)
      end)) as $todos
| ($calls | map(select(hidden | not))) as $work
| ($work[-8:] | map(
    $res[.id] as $r
    | (if $r == null then "NO RESULT: still running (or waiting for permission) when the laptop slept"
       elif $r.err then "error: " + ($r.text | gsub("</?tool_use_error>"; "") | oneline | clip(120))
       elif $bg[.id] then "ran in the background: " + $bg[.id]
       elif ($r.text | test("^(Command running in background|Async agent launched)")) then
         "started in the background and still running when the laptop slept; its output is lost"
       else "done" end) as $state
    | "- " + .name + (summary | if . == "" then "" else ": " + . end) + "  [" + $state + "]")
  | join("\n")) as $doing
| ($todos[-30:] | map("- [\(.status)] \(.content // "" | tostring | oneline | clip(200))") | join("\n")) as $list
| ($m | map(select(.who == "USER")) | first | .text // "" | .[0:3000]) as $first
| ($m[-30:] | map("\(.who): \(.text | .[0:2000])") | join("\n\n")) as $recent
| (if $list == "" then "" else "\n\nTASK LIST (latest state in the local session):\n" + $list end) as $listpart
| (if $doing == "" then "" else
    "\n\nWHAT THE LOCAL SESSION WAS DOING (its last \($work[-8:] | length) of \($work | length) tool calls, oldest first). "
    + "Check the repository before repeating any of them:\n" + $doing end) as $doingpart
| ([$max - ($first + $listpart + $doingpart | length) - 200, 1000] | max) as $room
| "ORIGINAL REQUEST:\n\($first)\n\nRECENT CONVERSATION (oldest first, may be cut at the start):\n\($recent | .[-$room:])"
  + $listpart + $doingpart
'

make_brief() {
  local transcript="$1" branch="$2" skipped="${3:-}" agents="${4:-}" excerpt left=""
  excerpt="$(jq -nrR --argjson max "$BRIEF_CHARS" "$BRIEF_JQ" "$transcript" 2>/dev/null)"
  [ -n "$excerpt" ] || excerpt="(The local transcript could not be read; work from the repository and the latest commits.)"
  [ -n "$skipped" ] && left="
These paths were left out of that commit and exist only on the laptop: nested git repositories (such as Claude Code's agent worktrees) and files too large to push. Do not expect them in the repository; work without them, or recreate what you need.
$(list_left_out "$skipped")
"
  cat <<EOF
You are taking over a Claude Code session from the user's laptop, which went to sleep in the middle of a task, so Sleepwalk handed the session to you. The user is away and cannot answer questions: make reasonable decisions, note them, and keep going.

The branch $branch holds the local work; its last commit, "WIP: hand off to cloud", has whatever was uncommitted. Work on it and stay on it: the user will bring this session back with \`claude --teleport\`, which checks out the session's branch. Follow the repository's CLAUDE.md or AGENTS.md.
$left
Continue where the local session stopped. Commit small, working steps often, and push each with \`git push -u <remote> HEAD\` to the remote this environment set up (see \`git remote -v\`; it may not be called origin). If there is no remote or the push is refused, do not add a remote or change git settings: keep committing, and say so in your summary.

When a message says the user is back: stop, commit everything, push, and end with a short summary for the user: what you did, what is left, and any decisions you made for them.
EOF
  if [ -n "$agents" ]; then
    printf '\nSubagents of the local session were working in separate git worktrees on the laptop. Their uncommitted changes stayed there and are not on your branch:\n'
    printf '%s\n' "$agents" | sed 's/^/  - /'
    printf 'Check which of that work the task still needs, and redo it here if so.\n'
  fi
  printf '\n%s\n' "$excerpt"
}

# subagent_worktrees <record>: prints the subagent worktrees recorded for a session that
# still have uncommitted changes, other than the session's own tree (the current folder).
# Those changes are not part of the handoff commit.
subagent_worktrees() {
  local own w
  own="$(git rev-parse --show-toplevel 2>/dev/null)"
  jq -r '.worktrees[]? // empty' "$1" 2>/dev/null | while IFS= read -r w; do
    [ -d "$w" ] || continue
    [ "$(git -C "$w" rev-parse --show-toplevel 2>/dev/null)" = "$own" ] && continue
    [ -n "$(git -C "$w" status --porcelain 2>/dev/null)" ] && printf '%s\n' "$w"
  done
}

# --- sleep --------------------------------------------------------------------------
# A session is "busy" from a prompt until Claude Code's Stop hook. The desktop app does
# not always send Stop, so a busy session counts only while it shows signs of life: a hook
# event or a write to its transcript within STALE_MINUTES. A long tool call (a big build,
# say) writes nothing, so keep STALE_MINUTES above the longest one you expect.
eligible() {
  local f="$1" status state last t tp seen
  status="$(field "$f" .handoff.status)"
  is_paused_status "$status" && return 1
  state="$(field "$f" .state)"
  last="$(field "$f" .last_activity)"; last="${last:-0}"
  tp="$(field "$f" .transcript_path)"
  if [ -n "$tp" ] && seen="$(stat -f %m "$tp" 2>/dev/null)" && [ "$seen" -gt "$last" ]; then
    last="$seen"
  fi
  t="$(now)"
  if [ "$state" = busy ] && [ $((t - last)) -le $((STALE_MINUTES * 60)) ]; then return 0; fi
  if [ "$SCOPE" = recent ] && [ $((t - last)) -le $((RECENT_MINUTES * 60)) ]; then return 0; fi
  return 1
}

# During a rehearsal, true for a session that sits it out: the one running the rehearsal,
# or any other than the one it was limited to.
simulated_out() {
  [ -n "$SIM_SKIP" ] && [ "$1" = "$SIM_SKIP" ] && return 0
  [ -n "$SIM_ONLY" ] && [ "$1" != "$SIM_ONLY" ] && return 0
  return 1
}

fail_handoff() {
  local sid="$1"; shift
  log "handoff $sid failed: $*"
  update_rec "$sid" --arg why "$*" --argjson t "$(now)" '.handoff = {status: "failed", error: $why, at: $t}'
}

HOLDING_PROMPT='Sleepwalk is handing you a Claude Code session from the user'"'"'s laptop, which is going to sleep. Your instructions arrive in the next message. Until it arrives, do nothing.'

# The expect(1) script that creates a cloud session. Creating one is interactive only
# (`--cloud` refuses `--print`), so it runs under expect in a pseudo-terminal. It prints
# "ID <session>" when the CLI reports the session, then keeps the client attached for a
# few seconds so the create completes. If Claude Code asks whether to trust the folder,
# it prints TRUST_PROMPT and stops; it never answers the prompt.
CREATE_EXP='
set timeout [lindex $argv 0]
set claude [lindex $argv 1]
set prompt [lindex $argv 2]
log_user 0
spawn -noecho $claude --cloud $prompt
expect {
  -re {teleport[^\n]*(session_[A-Za-z0-9]+)} {
    puts "ID $expect_out(1,string)"; flush stdout
    set timeout 15
    expect eof
    exit 0
  }
  -re {Quick[^\n]*safety[^\n]*check} { puts "TRUST_PROMPT"; flush stdout; exit 2 }
  timeout { puts "TIMEOUT"; flush stdout; exit 1 }
  eof { puts "EOF"; flush stdout; exit 1 }
}
'

# cloud_create <brief> <session-id> <deadline>: starts a cloud session for $PWD, gives it
# the brief, and prints its id. The brief goes as a message with `-p --cloud <id>`, which
# reports ok only for a session that exists, so it also confirms the create; it is
# retried until the deadline. Prints nothing on failure, and says why in the log.
cloud_create() {
  local exp="$HANDOFF_HOME/cloud-create-$2.exp" res="$HANDOFF_HOME/cloud-create-$2.res"
  local pid id="" sent=0 out="" wait
  wait=$(( $3 - $(now) ))
  [ "$wait" -gt 0 ] || { log "no time left to create a cloud session"; return 0; }
  printf '%s' "$CREATE_EXP" > "$exp"
  : > "$res"
  SLEEPWALK_INTERNAL=1 expect -f "$exp" "$((wait > 2 ? wait - 1 : wait))" "$(claude_bin)" "$HOLDING_PROMPT" > "$res" 2>&1 &
  pid=$!
  while [ "$(now)" -lt "$3" ]; do
    id="$(sed -n 's/^ID //p' "$res" | head -1)"
    [ -n "$id" ] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.2
  done
  if [ -n "$id" ]; then
    while [ "$(now)" -lt "$3" ]; do
      out="$(SLEEPWALK_INTERNAL=1 "$(claude_bin)" -p --output-format json --cloud "$id" "$1" < /dev/null 2>&1)"
      if [ "$(printf '%s' "$out" | jq -r '.ok // false' 2>/dev/null)" = true ]; then sent=1; break; fi
      sleep 1
    done
  fi
  kill "$pid" 2>/dev/null
  if [ "$sent" = 1 ]; then
    echo "$id"
  elif [ -n "$id" ]; then
    log "cloud session $id was created but did not accept the brief: $(printf '%s' "$out" | head -c 300)"
  elif grep -q '^TRUST_PROMPT' "$res"; then
    log "Claude Code asked whether to trust $PWD before creating a cloud session, and Sleepwalk does not answer that. If you trust it, run: sleepwalk trust \"$PWD\""
  else
    log "claude --cloud reported no session ($(tr -s '\n' ' ' < "$res" | head -c 200))"
  fi
  rm -f "$exp" "$res"
}

# --- the WIP commit -----------------------------------------------------------------
# Some uncommitted things must stay out of the WIP commit. An untracked nested git
# repository (Claude Code's agent worktrees in .claude/worktrees/<name>, or any other
# clone inside the checkout) would go in as a gitlink with no .gitmodules entry, which the
# cloud session cannot check out. A file over MAX_FILE_MB would make the push fail. Both
# are left in the working tree, untouched, and named in the commit message, the brief and
# the log. These functions take paths relative to the top of the working tree; run them
# there. Paths are one per line, so a path with a newline in it is not handled.

# left_out: prints "<path><TAB><reason>" for each thing the WIP commit leaves out. A
# nested repository's path ends in /. Changes nothing, so a dry run can use it too.
left_out() {
  local mb="$MAX_FILE_MB"
  case "$mb" in ''|*[!0-9]*) mb=50 ;; esac
  if [ "$INCLUDE_UNTRACKED" = 1 ]; then
    # Without --directory, ls-files names untracked folders only when they are nested
    # repositories, and then with a trailing /.
    git ls-files -z -o --exclude-standard | tr '\0' '\n' | grep '/$' | sed 's/$/	a nested git repository/'
  fi
  [ "$mb" -gt 0 ] || return 0
  { [ "$INCLUDE_UNTRACKED" = 1 ] && git ls-files -z -o --exclude-standard; git ls-files -z -m; } | tr '\0' '\n' \
    | grep -v '/$' | sed 's|^|./|' | tr '\n' '\0' \
    | xargs -0 -J % find % -prune -type f -size +"${mb}"M 2>/dev/null \
    | sed "s|^\./||;s/\$/	over ${mb} MB/"
  return 0
}

# stage_changes <left-out>: stages everything for the WIP commit except what left_out
# named, and prints "<path><TAB><reason>" for any other nested repository it had to take
# back out of the index (one the user staged by hand). A gitlink already in HEAD, or one
# that .gitmodules names, is a real submodule and is committed as usual.
stage_changes() {
  local p mode=-u gitmods
  [ "$INCLUDE_UNTRACKED" = 1 ] && mode=-A
  { printf ':/\0'
    printf '%s\n' "$1" | cut -f1 | while IFS= read -r p; do
      [ -n "$p" ] && printf ':(exclude,literal)%s\0' "${p%/}"
    done
  } | git add "$mode" --pathspec-from-file=- --pathspec-file-nul || return 1
  # Something left out may have been staged earlier by hand: unstage it again.
  printf '%s\n' "$1" | cut -f1 | while IFS= read -r p; do
    [ -n "$p" ] && git reset -q -- ":(literal)${p%/}" >/dev/null 2>&1
  done
  gitmods="$(git config -f .gitmodules --get-regexp '\.path$' 2>/dev/null | cut -d' ' -f2-)"
  git -c core.quotePath=false diff --cached --raw --no-renames --diff-filter=A \
    | awk -F'\t' '$1 ~ /^:[0-7]+ 160000 / { print $2 }' \
    | while IFS= read -r p; do
        printf '%s\n' "$gitmods" | grep -qxF -- "$p" && continue
        git rm -q --cached -- ":(literal)$p" && printf '%s/\ta nested git repository\n' "$p"
      done
  return 0
}

# list_left_out <left-out>: one "- <path> (<reason>)" line each.
list_left_out() {
  printf '%s\n' "$1" | awk -F'\t' 'NF { print "- " $1 " (" $2 ")" }'
}

# undo_handoff: puts the checkout back as it was before a handoff that failed. Drops the
# WIP commit (its changes stay in the working tree), returns to the original branch, and
# takes the branch back off the remote if it was pushed. Uses handoff_one's variables.
undo_handoff() {
  local wip
  wip="$(git rev-parse HEAD)"
  [ "$made_commit" = 1 ] && git reset -q --mixed HEAD~1
  if [ "$made_branch" = 1 ]; then
    git switch -q "$orig" 2>/dev/null || git switch -q --detach "$orig"
    git branch -q -D "$branch"
    [ "$pushed" = 1 ] && git push -q origin --delete "$branch" 2>>"$LOG"
  elif [ "$pushed" = 1 ] && [ "$made_commit" = 1 ]; then
    if [ -n "$prev_remote" ]; then
      git push -q --force-with-lease="$branch:$wip" origin "$prev_remote:refs/heads/$branch" 2>>"$LOG"
    else
      git push -q origin --delete "$branch" 2>>"$LOG"
    fi
  fi
  log "  $sid: put $PWD back on $orig as it was"
}

handoff_one() {
  local f="$1" dry="$2" deadline="$3" sid cwd transcript branch default newb brief cloud_id url t0
  local orig prev_remote made_branch=0 made_commit=0 pushed=0 top skipped more body line agents w
  t0="$(now)"
  sid="$(basename "$f" .json)"
  cwd="$(field "$f" .cwd)"
  transcript="$(field "$f" .transcript_path)"
  { [ -n "$cwd" ] && cd "$cwd" 2>/dev/null; } || { fail_handoff "$sid" "working directory $cwd is gone"; return; }
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { log "skip $sid: $cwd is not a git checkout"; return; }
  git remote get-url origin >/dev/null 2>&1 || { log "skip $sid: $cwd has no origin remote"; return; }
  # The lid may have opened while the handoff was waiting (for example on a privacy prompt).
  if [ "$dry" != 1 ] && [ "$TRIGGER" = lid ] && ! lid_closed; then
    log "skip $sid: the lid opened before the handoff began"; return
  fi
  # Subagents' worktrees are separate checkouts, so their uncommitted work is not handed
  # off. Say where it is.
  agents="$(subagent_worktrees "$f")"
  if [ -n "$agents" ]; then
    printf '%s\n' "$agents" | while IFS= read -r w; do
      log "  $sid: subagent worktree $w has uncommitted changes, which stay on this Mac"
    done
  fi

  branch="$(git symbolic-ref --short -q HEAD)"
  orig="${branch:-$(git rev-parse HEAD)}"
  default="$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)"
  default="${default#origin/}"; default="${default:-main}"
  if [ -z "$branch" ] || [ "$branch" = "$default" ]; then
    newb="sleepwalk/$(date +%Y%m%d-%H%M%S)-$(printf '%s' "$sid" | cut -c1-8)"
    if [ "$dry" = 1 ]; then log "dry run $sid: would create branch $newb"; else
      git switch -q -c "$newb" || { fail_handoff "$sid" "could not create branch $newb"; return; }
      made_branch=1
    fi
    branch="$newb"
  fi

  top="$(git rev-parse --show-toplevel)"
  skipped="$(cd "$top" && left_out)"
  if [ "$dry" = 1 ]; then
    log "dry run $sid: would commit, push $branch and start a cloud session from $cwd"
    printf '%s\n' "$skipped" | awk -F'\t' -v s="$sid" 'NF { print "dry run " s ": would leave out " $1 " (" $2 ")" }' \
      | while IFS= read -r line; do log "$line"; done
    make_brief "$transcript" "$branch" "$skipped" "$agents" > "$HANDOFF_HOME/dry-run-brief-$sid.txt"
    return
  fi

  prev_remote="$(git rev-parse -q --verify "refs/remotes/origin/$branch" 2>/dev/null)"
  more="$(cd "$top" && stage_changes "$skipped")" \
    || { undo_handoff; fail_handoff "$sid" "git add failed"; return; }
  [ -n "$more" ] && skipped="$(printf '%s\n%s' "$skipped" "$more" | grep .)"
  printf '%s\n' "$skipped" | awk -F'\t' -v s="$sid" 'NF { print "  " s ": left out " $1 " (" $2 ")" }' \
    | while IFS= read -r line; do log "$line"; done
  body="Committed automatically by sleepwalk for Claude Code session $sid."
  [ -n "$skipped" ] && body="$body

Left out of this commit, still only on the laptop:
$(list_left_out "$skipped")"
  if ! git diff --cached --quiet; then
    git commit -q -s --no-verify -m "WIP: hand off to cloud while the laptop sleeps" -m "$body" \
      || { undo_handoff; fail_handoff "$sid" "git commit failed"; return; }
    made_commit=1
  fi
  if ! git push -q origin "HEAD:refs/heads/$branch" 2>>"$LOG"; then
    undo_handoff; fail_handoff "$sid" "git push of $branch failed"; return
  fi
  pushed=1
  log "  $sid: committed and pushed $branch after $(( $(now) - t0 ))s"

  brief="$(make_brief "$transcript" "$branch" "$skipped" "$agents")"
  # Leave time before the deadline to undo the push and record the result.
  cloud_id="$(cloud_create "$brief" "$sid" $((deadline - 4)))"
  if [ -z "$cloud_id" ]; then
    undo_handoff
    fail_handoff "$sid" "could not start a cloud session (see the log)"
    return
  fi
  url="https://claude.ai/code/$cloud_id"
  update_rec "$sid" --arg id "$cloud_id" --arg url "$url" --arg b "$branch" --arg sha "$(git rev-parse HEAD)" \
    --argjson t "$(now)" '.handoff = {status: "cloud", cloud_id: $id, url: $url, branch: $b, sha: $sha, at: $t}'
  log "handed $sid ($cwd, $branch) to cloud session $cloud_id $url after $(( $(now) - t0 ))s"
}

cmd_sleep() {
  local dry=0 f pids="" deadline running p top prev_top="" cand cwd
  [ "${1:-}" = --dry-run ] && dry=1
  if [ "$TRIGGER" = lid ] && ! lid_closed; then log "sleep with the lid open; nothing handed off"; return 0; fi
  deadline=$(( $(now) + SLEEP_BUDGET ))
  mkdir -p "$HANDOFF_HOME"
  cand="$HANDOFF_HOME/sleep-candidates.$$"
  cleanup_add "$cand"
  log "sleep: looking for busy sessions"
  # One cloud session per working tree: when several busy sessions share a tree, only
  # the most recently active one is handed off, so no two agents race on its commit.
  for f in "$SESSIONS"/*.json; do
    [ -f "$f" ] || continue
    eligible "$f" || continue
    simulated_out "$(field "$f" .session_id)" && continue
    cwd="$(field "$f" .cwd)"
    # git -C "" would use this process's own folder, so a missing cwd is skipped here.
    [ -n "$cwd" ] && [ -d "$cwd" ] || { log "skip $(basename "$f" .json): working directory ${cwd:-(none)} is gone"; continue; }
    top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || top="$cwd"
    printf '%s\t%s\t%s\n' "$top" "$(jq -r '.last_activity // 0' "$f" 2>/dev/null || echo 0)" "$f"
  done | sort -t "$(printf '\t')" -k1,1 -k2,2nr > "$cand"
  if [ -s "$cand" ] && [ -n "$HOTSPOT_SSID" ] && [ "$dry" != 1 ] && ! have_network 3; then
    join_hotspot "$(( deadline - 8 ))"
  fi
  while IFS="$(printf '\t')" read -r top _ f; do
    if [ "$top" = "${prev_top:-}" ]; then
      log "skip $(field "$f" .session_id): shares $top with a more recent session"
      continue
    fi
    prev_top="$top"
    ( handoff_one "$f" "$dry" "$deadline" ) &
    pids="$pids $!:$(basename "$f" .json)"
    # If the watcher stops this step (SIGTERM past its budget), the handoffs stop too.
    CLEANUP_PIDS="$CLEANUP_PIDS $!"
  done < "$cand"
  [ -n "$pids" ] || { log "sleep: no busy sessions to hand off"; return 0; }
  # Handoffs run in parallel; anything still running at the deadline is stopped so the
  # Mac can sleep, and is recorded as failed so the wake step tells the user.
  while [ "$(now)" -lt "$deadline" ]; do
    running=0
    for p in $pids; do kill -0 "${p%%:*}" 2>/dev/null && running=1; done
    [ "$running" = 0 ] && break
    sleep 0.2
  done
  for p in $pids; do
    if kill -0 "${p%%:*}" 2>/dev/null; then
      stop_pid "${p%%:*}"
      log "a handoff ran past the ${SLEEP_BUDGET}s budget and was stopped"
      [ "$dry" = 1 ] || [ "$(field "$(rec "${p#*:}")" .handoff.status)" = cloud ] \
        || fail_handoff "${p#*:}" "the handoff ran past the ${SLEEP_BUDGET}s sleep budget; check the branch and the last commit in $(field "$(rec "${p#*:}")" .cwd)"
    fi
  done
  wait 2>/dev/null
  CLEANUP_PIDS=""
  return 0
}

# --- network ------------------------------------------------------------------------
have_network() {
  [ "$SIM_OFFLINE_UNTIL" -gt "$(now)" ] && return 1
  # SLEEPWALK_NETWORK=fake lets the tests decide: up once $HANDOFF_HOME/net-up exists.
  if [ "${SLEEPWALK_NETWORK:-}" = fake ]; then [ -f "$HANDOFF_HOME/net-up" ]; return; fi
  curl -s -o /dev/null -m "${1:-5}" https://claude.ai
}

# join_hotspot <deadline>: with no network and HOTSPOT_SSID set (say, an iPhone's Personal
# Hotspot), joins that Wi-Fi network and waits for the network until HOTSPOT_WAIT or the
# deadline runs out. macOS supplies the password it saved when the user joined the
# hotspot by hand; Sleepwalk never handles it.
join_hotspot() {
  local dev until
  [ -n "$HOTSPOT_SSID" ] || return 1
  if [ "$SIM_OFFLINE_UNTIL" -gt "$(now)" ]; then
    log "simulated: no network; would join $HOTSPOT_SSID now"; return 1
  fi
  dev="$(wifi_device)"
  [ -n "$dev" ] || { log "no Wi-Fi device found to join $HOTSPOT_SSID"; return 1; }
  log "no network; joining $HOTSPOT_SSID on $dev"
  "$NETWORKSETUP" -setairportnetwork "$dev" "$HOTSPOT_SSID" >> "$LOG" 2>&1
  until=$(( $(now) + HOTSPOT_WAIT ))
  [ -n "${1:-}" ] && [ "$1" -lt "$until" ] && until="$1"
  while [ "$(now)" -lt "$until" ]; do
    have_network 2 && { log "on the network through $HOTSPOT_SSID"; return 0; }
    sleep 1
  done
  log "still no network after joining $HOTSPOT_SSID"
  return 1
}

wifi_device() {
  "$NETWORKSETUP" -listallhardwareports 2>/dev/null \
    | awk '/^Hardware Port: (Wi-Fi|AirPort)/ { getline; print $2; exit }'
}

# sleepwalk hotspot [name]: lists the iPhone hotspots macOS has saved (through iCloud,
# no password needed), or sets HOTSPOT_SSID to the saved network that matches <name>.
# Matching ignores case and treats a typed ' as the ’ iPhone names use.
cmd_hotspot() {
  local dev saved want match n
  dev="$(wifi_device)"
  [ -n "$dev" ] || die "no Wi-Fi device found"
  saved="$("$NETWORKSETUP" -listpreferredwirelessnetworks "$dev" 2>/dev/null | sed -n 's/^[[:space:]]*//p' | grep -i 'iphone\|ipad')"
  if [ $# -eq 0 ]; then
    echo "Hotspot now: ${HOTSPOT_SSID:-(none)}"
    echo "Saved iPhone and iPad hotspots:"
    printf '%s\n' "$saved" | sed 's/^/  /'
    echo "Choose one with: sleepwalk hotspot \"<name>\""
    return 0
  fi
  want="$(printf '%s' "$*" | sed "s/'/’/g" | tr '[:upper:]' '[:lower:]')"
  match="$(printf '%s\n' "$saved" | while IFS= read -r line; do
    [ "$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]')" = "$want" ] && printf '%s\n' "$line"
  done)"
  n="$(printf '%s' "$match" | grep -c .)"
  [ "$n" = 1 ] || die "no saved network is called '$*' (sleepwalk hotspot lists them)"
  mkdir -p "$HANDOFF_HOME"
  touch "$CONFIG"
  grep -v '^HOTSPOT_SSID=' "$CONFIG" > "$CONFIG.tmp"
  printf 'HOTSPOT_SSID=%q\n' "$match" >> "$CONFIG.tmp"
  mv "$CONFIG.tmp" "$CONFIG"
  echo "Sleepwalk will join $match when there is no network at sleep or wake."
}

# --- wake and resume ----------------------------------------------------------------
# wait_for_network: waits for the network for as long as the lid stays open, so a Mac
# opened somewhere without Wi-Fi brings its sessions back once it gets online. Says so in
# a notification after NETWORK_WAIT. Fails only if the lid closes again first.
wait_for_network() {
  local start tried=0 told=0
  start="$(now)"
  until have_network 5; do
    lid_closed && return 1
    # Give the usual networks a few seconds to come back before reaching for the hotspot.
    if [ "$tried" = 0 ] && [ -n "$HOTSPOT_SSID" ] && [ $(( $(now) - start )) -ge 8 ]; then
      tried=1; join_hotspot && return 0
    fi
    if [ "$told" = 0 ] && [ $(( $(now) - start )) -ge "$NETWORK_WAIT" ]; then
      told=1
      log "wake: no network after ${NETWORK_WAIT}s; still waiting"
      notify "No network yet. Your sessions come back from the cloud as soon as the Mac is online."
    fi
    sleep 3
  done
}

# remote_sha <branch> [dir]: the branch's commit on origin, or nothing if it cannot be read.
remote_sha() {
  git -C "${2:-.}" ls-remote origin "refs/heads/$1" 2>/dev/null | cut -f1
}

# send_wrapup <session-id>: tells the cloud session the user is back. Notes where its
# branch stood first, so resume can tell when it pushes. The session counts as returning
# only once the message got through; otherwise the next wake or resume sends it again.
send_wrapup() {
  local sid="$1" f cloud_id sha
  f="$(rec "$sid")"
  cloud_id="$(field "$f" .handoff.cloud_id)"
  [ -n "$cloud_id" ] || return 1
  sha="$(remote_sha "$(field "$f" .handoff.branch)" "$(field "$f" .cwd)")"
  if SLEEPWALK_INTERNAL=1 "$(claude_bin)" -p --output-format json --cloud "$cloud_id" "$WRAPUP_MSG" < /dev/null >>"$LOG" 2>&1; then
    log "asked cloud session $cloud_id to wrap up"
    update_rec "$sid" --arg sha "$sha" --argjson t "$(now)" \
      '.handoff.status = "returning" | .handoff.wrapup_at = $t | .handoff.wrapup_sha = $sha'
  else
    log "could not message cloud session $cloud_id; it will keep running"
    return 1
  fi
}

open_resume_terminal() {
  local sid="$1" cmdfile="$HANDOFF_HOME/resume-$1.command"
  printf '#!/bin/bash\nexec %q resume %q\n' "$SELF" "$sid" > "$cmdfile"
  chmod +x "$cmdfile"
  # SLEEPWALK_OPEN lets the tests see which windows would open, and in what order.
  if [ -n "${SLEEPWALK_OPEN:-}" ]; then "$SLEEPWALK_OPEN" "$cmdfile"; else open -a "$TERMINAL_APP" "$cmdfile"; fi \
    || { rm -f "$cmdfile"; log "could not open $TERMINAL_APP for $sid"; }
}

# notify <body>: a macOS notification titled "Sleepwalk". The text goes to AppleScript as
# an argument, never inside the script, so quotes and backslashes need no escaping.
notify() {
  log "notify: $1"
  [ -n "${SLEEPWALK_NO_NOTIFY:-}" ] && return 0
  "${OSASCRIPT:-osascript}" - "Sleepwalk" "$1" >/dev/null 2>&1 <<'EOF' || true
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
EOF
}

# repo_name <folder>: the repository's folder name, for notifications.
repo_name() {
  local top
  top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || top="$1"
  basename "$top"
}

# take_lock <dir>: holds a lock for this process. A lock whose process has died is taken over.
take_lock() {
  if ! mkdir "$1" 2>/dev/null; then
    lock_held "$1" && return 1
    rm -rf "$1"; mkdir "$1" 2>/dev/null || return 1
  fi
  echo $$ > "$1/pid"
}

lock_held() {
  local p
  p="$(cat "$1/pid" 2>/dev/null)"
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

# A session is waiting to come back when it is still in the cloud, or was told to wrap
# up but no resume is running for it (its window was closed, or teleport failed).
waiting_to_return() {
  case "$(field "$1" .handoff.status)" in
    cloud) return 0 ;;
    returning) ! lock_held "$HANDOFF_HOME/resume-$(field "$1" .session_id).lock" ;;
    *) return 1 ;;
  esac
}

cmd_wake() {
  local lock="$HANDOFF_HOME/wake.lock" f sid order n=0
  if lid_closed; then return 0; fi  # a dark wake (Power Nap); the user is not back
  log "wake: the lid is open"
  mkdir -p "$HANDOFF_HOME"
  take_lock "$lock" || return 0
  cleanup_add "$lock"
  maybe_prune
  # Oldest handoff first, so the windows open in a steady order with the latest on top.
  order="$(for f in "$SESSIONS"/*.json; do
    [ -f "$f" ] || continue
    if [ "$(field "$f" .handoff.status)" = failed ]; then
      notify "Couldn't hand off $(repo_name "$(field "$f" .cwd)") at sleep: $(field "$f" .handoff.error). Your work is untouched here."
      update_rec "$(basename "$f" .json)" 'del(.handoff)'
    fi
    waiting_to_return "$f" && printf '%s %s\n' "$(field "$f" .handoff.at)" "$(field "$f" .session_id)"
  done | sort -n | cut -d' ' -f2)"
  [ -n "$order" ] || return 0
  wait_for_network || { log "wake: the lid closed again before the network came back"; return 0; }
  # Tell every cloud session first, so they all start wrapping up at once.
  for sid in $order; do
    [ "$(field "$(rec "$sid")" .handoff.status)" = cloud ] && send_wrapup "$sid"
  done
  for sid in $order; do
    if [ "$AUTO_RESUME" = 1 ]; then
      [ "$n" -gt 0 ] && sleep 1
      open_resume_terminal "$sid"; n=$((n + 1))
    else
      notify "Your session in $(repo_name "$(field "$(rec "$sid")" .cwd)") is still in the cloud. Run: sleepwalk resume $(short_id "$sid")"
    fi
  done
  # The windows may open on another Space, behind a full-screen app. Bring the terminal
  # forward, and say where the sessions are.
  if [ "$n" -gt 0 ]; then
    [ -n "${SLEEPWALK_OPEN:-}" ] || osascript -e "tell application \"$TERMINAL_APP\" to activate" >/dev/null 2>&1
    notify "$(plural "$n" session) kept working in the cloud — bringing $([ "$n" = 1 ] && echo it || echo them) back in $TERMINAL_APP."
  fi
}

# The LaunchAgent's first access to ~/Documents, ~/Desktop or ~/Downloads raises a macOS
# privacy prompt that blocks until answered. The watcher runs this at start-up, so the
# prompt comes at install time rather than in the seconds before sleep. Only folders that
# hold Claude Code projects are touched, so most people see one prompt, once.
cmd_preflight() {
  local d name projects="$HOME/.claude/projects" prefix
  prefix="$(printf '%s' "$HOME" | tr '/.' '--')"
  for name in Documents Desktop Downloads; do
    d="$HOME/$name"
    [ -d "$d" ] || continue
    set -- "$projects/$prefix-$name" "$projects/$prefix-$name"-*
    if [ -e "$1" ] || [ -e "$2" ] || grep -qs "\"cwd\": *\"$d" "$SESSIONS"/*.json; then
      ls "$d" >/dev/null 2>&1
    fi
  done
  return 0
}

# Accepts a full session id or a unique prefix of one.
resolve_sid() {
  local want="$1" f match="" n=0
  for f in "$SESSIONS"/"$want"*.json; do
    [ -f "$f" ] || continue
    match="$(basename "$f" .json)"; n=$((n + 1))
  done
  [ "$n" = 1 ] || die "no single session matches '$want' (found $n); see sleepwalk status"
  echo "$match"
}

# The resume window shows one status line, rewritten in place on a terminal. When the
# output is not a terminal, each step prints once instead.
TTY=0

# tick <text>: shows the status line and waits about a second. Succeeds if Enter was pressed.
tick() {
  local rc
  [ "$TTY" = 1 ] && printf '\r\033[K%s' "$1"
  read -r -t 1 _ && return 0
  rc=$?
  [ "$rc" -gt 128 ] || sleep 1   # end of input rather than a timeout: wait the second anyway
  return 1
}

# say <text>: replaces the status line with a line that stays.
say() {
  [ "$TTY" = 1 ] && printf '\r\033[K'
  printf '%s\n' "$1"
}

# show_commits <branch> <from> <to>: fetches the cloud branch and lists what it added.
show_commits() {
  local n
  [ -n "$2" ] || return 0
  git fetch -q origin "refs/heads/$1" 2>/dev/null || return 0
  n="$(git rev-list --count "$3" --not "$2" 2>/dev/null)" || return 0
  [ "$n" -gt 0 ] || return 0
  say "New on $1:"
  git log --oneline --no-decorate -5 "$3" --not "$2" | sed 's/^/  /'
  [ "$n" -gt 5 ] && echo "  ... and $((n - 5)) more"
}

# wait_for_push <branch> <base> <handoff-sha>: polls the cloud branch on origin until the
# cloud session has pushed past <base> and then stayed still for PUSH_QUIET seconds. Gives
# up after WRAPUP_WAIT seconds, or at Enter. Lists the commits the cloud session made since
# the handoff as they appear.
wait_for_push() {
  local branch="$1" seen="$2" shown="$3" out="$HANDOFF_HOME/poll.$$" pid="" got t start end moved=0 next=0 what
  start="$(now)"; end=$((start + WRAPUP_WAIT))
  [ "$TTY" = 1 ] || echo "Waiting up to ${WRAPUP_WAIT}s for the cloud session to push. Press Enter to go now."
  rm -f "$out"
  while t="$(now)"; [ "$t" -lt "$end" ]; do
    # ls-remote runs in the background, so a slow network never stalls the countdown.
    if [ -f "$out" ]; then
      got="$(cat "$out")"; rm -f "$out"; pid=""
      if [ -n "$got" ]; then
        [ -n "$seen" ] || seen="$got"
        [ -n "$shown" ] || shown="$got"
        [ "$got" != "$shown" ] && { show_commits "$branch" "$shown" "$got"; shown="$got"; }
        [ "$got" != "$seen" ] && { seen="$got"; moved="$t"; }
      fi
    fi
    if [ "$moved" -gt 0 ] && [ $((t - moved)) -ge "$PUSH_QUIET" ]; then
      say "The cloud session has pushed."; break
    fi
    if [ -z "$pid" ] && [ -n "$branch" ] && [ "$t" -ge "$next" ]; then
      ( remote_sha "$branch" > "$out.tmp"; mv "$out.tmp" "$out" ) &
      pid=$!; next=$((t + ${SLEEPWALK_POLL:-2}))
    fi
    what="Waiting for the cloud session to push"
    [ "$moved" -gt 0 ] && what="Cloud session pushed; waiting for it to finish"
    tick "$what... $((t - start))s  (Enter to go now)" && { say "Going now."; break; }
  done
  if [ "$t" -ge "$end" ]; then
    if [ "$moved" -gt 0 ]; then say "Waited ${WRAPUP_WAIT}s; going now."; else say "No new push after ${WRAPUP_WAIT}s; going now."; fi
  fi
  [ -n "$pid" ] && kill "$pid" 2>/dev/null
  rm -f "$out" "$out.tmp"
}

# next_steps <session-id> <url>: what to do when the session could not be brought back.
next_steps() {
  local me=sleepwalk
  [ "$(command -v sleepwalk 2>/dev/null)" = "$SELF" ] || me="$(printf '%q' "$SELF")"
  echo "  Open it on the web:  $2"
  echo "  Try again:           $me resume $(short_id "$1")"
  echo "  Keep the local copy: $me release $(short_id "$1")"
}

# short_id <session-id>: its first 8 characters, when no other session starts with them.
short_id() {
  local full="$1" s="${1:0:8}"
  set -- "$SESSIONS/$s"*.json
  if [ $# = 1 ]; then echo "$s"; else echo "$full"; fi
}

cmd_resume() {
  local sid f status cloud_id url cwd branch name lock end t0 rc
  [ $# -ge 1 ] || die "usage: sleepwalk resume <session-id>"
  sid="$(resolve_sid "$1")" || exit 1
  rm -f "$HANDOFF_HOME/resume-$sid.command"
  f="$(rec "$sid")"
  status="$(field "$f" .handoff.status)"
  cloud_id="$(field "$f" .handoff.cloud_id)"
  url="$(field "$f" .handoff.url)"; url="${url:-$cloud_id}"
  cwd="$(field "$f" .cwd)"
  branch="$(field "$f" .handoff.branch)"
  { is_paused_status "$status" && [ -n "$cloud_id" ]; } || die "session $sid has no cloud handoff to resume"
  lock="$HANDOFF_HOME/resume-$sid.lock"
  take_lock "$lock" || die "session $sid is already being resumed in another window"
  cleanup_add "$lock"
  cd "$cwd" || die "working directory $cwd is gone"
  name="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$cwd")")"
  # On a terminal: a clean title, and a cleared screen, so the window shows Sleepwalk
  # alone rather than the login banner and the .command line Terminal typed.
  if [ -t 1 ]; then
    TTY=1
    printf '\033]0;Sleepwalk · %s\007\033[2J\033[3J\033[H' "$name"
  fi
  echo "Sleepwalk · $name"
  echo "  branch  ${branch:-?}"
  echo "  cloud   $url"
  echo
  # Terminal starts a .command by typing it into a shell, and that line's Enter can still
  # be waiting to be read. Discard pending input first, so it does not end the wait.
  while read -r -t 1 _; do :; done

  if ! have_network 3; then
    end=$(( $(now) + NETWORK_WAIT )); t0="$(now)"
    [ "$TTY" = 1 ] || echo "Waiting up to ${NETWORK_WAIT}s for the network."
    until have_network 3; do
      [ "$(now)" -ge "$end" ] && break
      tick "Waiting for the network... $(( $(now) - t0 ))s  (Enter to try anyway)" && break
    done
    have_network 3 || {
      say "Still no network. The session keeps running in the cloud:"
      next_steps "$sid" "$url"
      exit 1
    }
    say "Online."
  fi
  [ "$status" = cloud ] && send_wrapup "$sid"
  wait_for_push "$branch" "$(field "$f" .handoff.wrapup_sha)" "$(field "$f" .handoff.sha)"

  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    echo "Files changed here since the handoff (teleport will offer to stash them):"
    git status --short | head -10 | sed 's/^/  /'
  fi
  echo
  # Marked resumed before teleport starts, so closing the window mid-session leaves no
  # session waiting to come back. A teleport that fails is put back below.
  update_rec "$sid" --argjson t "$(now)" '.handoff.status = "resumed" | .handoff.resumed_at = $t'
  log "teleporting cloud session $cloud_id back into $cwd"
  t0="$(now)"
  KEEP_ON_HUP=1   # a closed window ends claude; still record how it went
  "$(claude_bin)" --teleport "$cloud_id"
  rc=$?
  [ "$rc" = 0 ] && return 0
  # A non-zero exit after a real session is just how that session ended. One within
  # seconds is teleport failing: keep the session paused, and ready for the next try.
  [ $(( $(now) - t0 )) -ge 120 ] && return "$rc"
  update_rec "$sid" '.handoff.status = "returning" | del(.handoff.resumed_at)'
  log "claude --teleport $cloud_id failed (exit $rc); $sid is still waiting to come back"
  echo
  echo "claude --teleport did not bring the session back (exit $rc). It is safe in the cloud:"
  next_steps "$sid" "$url"
  exit "$rc"
}

cmd_release() {
  local sid f cloud_id
  [ $# -ge 1 ] || die "usage: sleepwalk release <session-id>"
  sid="$(resolve_sid "$1")" || exit 1
  f="$(rec "$sid")"
  [ "$(field "$f" .handoff.status)" = cloud ] && send_wrapup "$sid"
  cloud_id="$(field "$f" .handoff.cloud_id)"
  update_rec "$sid" 'del(.handoff)'
  rm -f "$HANDOFF_HOME/resume-$sid.command"
  log "released $sid from cloud session ${cloud_id:-none}"
  echo "Session $sid is no longer paused. Pull the cloud branch first if you want its work."
}

# --- status -------------------------------------------------------------------------
# human_age <seconds>: "just now", "4m", "3h", "2d".
human_age() {
  local s="${1:-0}"
  [ "$s" -ge 0 ] 2>/dev/null || s=0
  if [ "$s" -lt 60 ]; then echo "just now"
  elif [ "$s" -lt 3600 ]; then echo "$((s / 60))m"
  elif [ "$s" -lt 86400 ]; then echo "$((s / 3600))h"
  else echo "$((s / 86400))d"; fi
}

# ago <seconds>: "4m ago", or "just now".
ago() {
  local a; a="$(human_age "$1")"
  if [ "$a" = "just now" ]; then echo "$a"; else echo "$a ago"; fi
}

# short_path <folder>: ~/... under $HOME, and only the folder's name when still long.
short_path() {
  local p="$1"
  # shellcheck disable=SC2088 # a literal ~ is the point
  case "$p" in "$HOME") p="~" ;; "$HOME"/*) p="~/${p#"$HOME"/}" ;; esac
  [ "${#p}" -gt 36 ] && p=".../$(basename "$1")"
  printf '%s' "$p"
}

plural() { # plural <n> <noun>
  if [ "$1" = 1 ]; then printf '1 %s' "$2"; else printf '%s %ss' "$1" "$2"; fi
}

watcher_running() {
  # SLEEPWALK_WATCHER=running|stopped lets the tests decide.
  case "${SLEEPWALK_WATCHER:-}" in running) return 0 ;; stopped) return 1 ;; esac
  launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1
}

# log_last <regex>: the time, in epoch seconds, of the last handoff.log line whose message
# matches the extended regex. Prints nothing when there is none.
log_last() {
  local line
  [ -f "$LOG" ] || return 0
  line="$(grep -E "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8} ($1)" "$LOG" | tail -1)"
  [ -n "$line" ] || return 0
  date -j -f '%Y-%m-%d %H:%M:%S' "$(printf '%s' "$line" | cut -c1-19)" +%s 2>/dev/null
}

all_records() { local f; for f in "$SESSIONS"/*.json; do [ -f "$f" ] && cat "$f"; done; }

# Sessions with no handoff in progress that have been quiet this long are left out of
# `status` unless --all is given.
STATUS_HIDE_DAYS="${STATUS_HIDE_DAYS:-3}"

# --- prune --------------------------------------------------------------------------
# Forgets what is no longer needed: sessions teleported back more than RESUMED_KEEP_HOURS
# ago, handoffs and sessions with no activity for PRUNE_DAYS, sessions whose transcript
# is gone, resume .command files nobody ran, and files left by processes that died.
# Runs at most hourly from SessionStart and wake, or any time with `sleepwalk prune`.
prune_rec() { # prune_rec <session-id> <why>
  rm -f "$(rec "$1")" "$HANDOFF_HOME/resume-$1.command"
  rmdir "$(rec "$1").lock" 2>/dev/null
  log "pruned $1: $2"
  pruned=$((pruned + 1))
}

cmd_prune() {
  local f sid status at last tp seen t c pruned=0
  t="$(now)"
  for f in "$SESSIONS"/*.json; do
    [ -f "$f" ] || continue
    sid="$(basename "$f" .json)"
    IFS=$'\037' read -r status at last tp <<EOF
$(jq -r '[.handoff.status // "", (.handoff.resumed_at // .handoff.at // 0), .last_activity // 0, .transcript_path // ""] | map(tostring) | join("\u001f")' "$f" 2>/dev/null)
EOF
    case "${last:-}" in ''|*[!0-9]*) last=0 ;; esac
    case "${at:-}" in ''|*[!0-9]*) at=0 ;; esac
    seen=""
    if [ -n "${tp:-}" ]; then
      seen="$(stat -f %m "$tp" 2>/dev/null)" && [ "$seen" -gt "$last" ] && last="$seen"
    fi
    case "${status:-}" in
      resumed)
        [ $((t - at)) -gt $((RESUMED_KEEP_HOURS * 3600)) ] && prune_rec "$sid" "teleported back over ${RESUMED_KEEP_HOURS}h ago" ;;
      cloud|returning)
        [ $((t - at)) -gt $((PRUNE_DAYS * 86400)) ] && prune_rec "$sid" "handed off over ${PRUNE_DAYS} days ago and never resumed" ;;
      failed) ;;   # kept until wake has told the user, which then clears it
      *)
        if [ $((t - last)) -gt $((PRUNE_DAYS * 86400)) ]; then
          prune_rec "$sid" "no activity for ${PRUNE_DAYS} days"
        elif [ -n "${tp:-}" ] && [ -z "$seen" ] && [ $((t - last)) -gt 86400 ]; then
          prune_rec "$sid" "transcript $tp is gone"
        fi ;;
    esac
  done
  # A resume .command is useful only while its session is still waiting in the cloud, and
  # for a day at most; `sleepwalk resume` does the same job after that.
  for c in "$HANDOFF_HOME"/resume-*.command; do
    [ -f "$c" ] || continue
    sid="$(basename "$c" .command)"; sid="${sid#resume-}"
    status="$(field "$(rec "$sid")" .handoff.status)"
    if [ "$status" != cloud ] && [ "$status" != returning ]; then
      rm -f "$c"; log "removed $(basename "$c"): the session is no longer in the cloud"
    elif [ -n "$(find "$c" -mmin +1440 2>/dev/null)" ]; then
      rm -f "$c"; log "removed $(basename "$c"): unused for a day"
    fi
  done
  # Temporary files and locks left behind by a process that was killed.
  find "$SESSIONS" -maxdepth 1 -name '*.tmp' -mmin +10 -exec rm -f {} + 2>/dev/null
  find "$SESSIONS" -maxdepth 1 -name '*.lock' -type d -mmin +10 -exec rmdir {} + 2>/dev/null
  find "$HANDOFF_HOME" -maxdepth 1 \( -name 'sleep-candidates.*' -o -name 'cloud-create-*' \) -mmin +60 -exec rm -f {} + 2>/dev/null
  rotate_log "$LOG"
  rotate_log "$HANDOFF_HOME/sleepwatch.log"
  [ "${1:-}" = --quiet ] || echo "Pruned $pruned session record(s)."
  return 0
}

# Runs cmd_prune at most once an hour, quietly.
maybe_prune() {
  local stamp="$HANDOFF_HOME/last-prune"
  [ -n "$(find "$stamp" -mmin -60 2>/dev/null)" ] && return 0
  mkdir -p "$HANDOFF_HOME" && : > "$stamp"
  cmd_prune --quiet >/dev/null 2>&1
}

cmd_status() {
  local json=0 all=0 t running last_sleep last_wake rows hidden=0 shown=0 summary
  local n_cloud n_back n_failed n_busy sid cwd branch state h age url err old where what c
  local b="" d="" g="" y="" r="" x=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --all|-a) all=1 ;;
      *) die "usage: sleepwalk status [--all] [--json]" ;;
    esac
    shift
  done
  t="$(now)"
  if watcher_running; then running=true; else running=false; fi
  last_sleep="$(log_last 'sleep: looking|sleep with the lid open')"
  last_wake="$(log_last 'wake: the lid is open')"

  if [ "$json" = 1 ]; then
    all_records | jq -s --argjson w "$running" --arg ls "$last_sleep" --arg lw "$last_wake" '{
        watcher: (if $w then "running" else "stopped" end),
        last_sleep: ($ls | tonumber? // null),
        last_wake: ($lw | tonumber? // null),
        sessions: sort_by(-(.last_activity // 0))
      }'
    return 0
  fi

  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
    b=$'\033[1m' d=$'\033[2m' g=$'\033[32m' y=$'\033[33m' r=$'\033[31m' x=$'\033[0m'
  fi

  # One row per session, the ones that need attention first (in the cloud, coming back,
  # failed, working), each group newest first. A busy session quiet for STALE_MINUTES
  # counts as idle, as it does at sleep. The age is since the handoff for a handed-off
  # session, and since its last activity otherwise.
  rows="$(all_records | jq -rs --argjson t "$t" --argjson hide "$((STATUS_HIDE_DAYS * 86400))" \
      --argjson stale "$((STALE_MINUTES * 60))" '
    def quiet: $t - (.last_activity // $t);
    def working: .state == "busy" and quiet <= $stale;
    def rank: {cloud: 0, returning: 1, failed: 2}[.handoff.status // ""]
      // (if working then 3 else 4 end);
    sort_by([rank, -(.last_activity // 0)])[]
    | (.handoff.status // "") as $h
    | quiet as $quiet
    | [ (.session_id // "?")[0:8], (.cwd // ""), (.handoff.branch // ""),
        (if working then "busy" else "idle" end), $h,
        (if $h == "" then $quiet else $t - (.handoff.at // .last_activity // $t) end),
        (.handoff.url // ""), (.handoff.error // ""),
        (if (rank > 2) and $quiet > $hide then "old" else "" end)
      ] | map(tostring | gsub("[\u001f\n]"; " ")) | join("\u001f")')"

  n_cloud="$(printf '%s\n' "$rows" | awk -F'\037' '$5 == "cloud"' | grep -c .)"
  n_back="$(printf '%s\n' "$rows" | awk -F'\037' '$5 == "returning"' | grep -c .)"
  n_failed="$(printf '%s\n' "$rows" | awk -F'\037' '$5 == "failed"' | grep -c .)"
  n_busy="$(printf '%s\n' "$rows" | awk -F'\037' '$5 == "" && $4 == "busy" && $9 == ""' | grep -c .)"

  # The summary line, watcher first because nothing is handed off without it.
  if [ "$running" = true ]; then summary="${g}watcher running${x}"
  else summary="${r}${b}watcher not running${x} (run: sleepwalk install)"; fi
  [ "$n_cloud" -gt 0 ] && summary="$summary · ${b}$(plural "$n_cloud" session) in the cloud${x}"
  [ "$n_back" -gt 0 ] && summary="$summary · $(plural "$n_back" session) coming back"
  [ "$n_failed" -gt 0 ] && summary="$summary · ${r}$(plural "$n_failed" "failed handoff")${x}"
  [ "$n_busy" -gt 0 ] && summary="$summary · $n_busy working"
  [ -n "$last_sleep" ] && summary="$summary · last sleep $(ago $((t - last_sleep)))"
  [ -n "$last_wake" ] && summary="$summary · last wake $(ago $((t - last_wake)))"
  printf 'Sleepwalk: %s\n' "$summary"

  if [ -z "$rows" ]; then echo; echo "No Claude Code sessions tracked yet."; return 0; fi
  echo
  # Fields are split on the unit separator: a tab would merge empty fields.
  while IFS=$'\037' read -r sid cwd branch state h age url err old; do
    if [ "$all" = 0 ] && [ -n "$old" ]; then hidden=$((hidden + 1)); continue; fi
    shown=$((shown + 1))
    [ -n "$branch" ] || branch="$(git -C "$cwd" symbolic-ref --short -q HEAD 2>/dev/null)"
    where="$(short_path "$cwd")"
    if [ -n "$branch" ]; then
      where="$where ($branch)"
      [ "${#where}" -gt 40 ] && where="$(basename "$cwd") ($branch)"
    fi
    [ "${#where}" -gt 40 ] && where="${where:0:37}..."
    case "$h" in
      cloud) what="in the cloud"; c="$b$g" ;;
      returning) what="coming back"; c="$y" ;;
      resumed) what="back (resumed)"; c="$d" ;;
      failed) what="failed: ${err:-unknown error}"; c="$r" ;;
      *) if [ "$state" = busy ]; then what="working"; c="$b"; else what="idle"; c="$d"; fi ;;
    esac
    printf '  %s%-8s%s  %-40s %s%8s%s  %s%s%s\n' "$d" "$sid" "$x" "$where" "$d" "$(human_age "$age")" "$x" "$c" "$what" "$x"
    if [ -n "$url" ] && [ "$h" != resumed ]; then printf '            %s\n' "$url"; fi
  done <<EOF
$rows
EOF
  [ "$shown" -gt 0 ] || echo "  No recent sessions."
  if [ "$hidden" -gt 0 ]; then
    echo
    echo "${d}$(plural "$hidden" "older idle session") not shown (sleepwalk status --all)${x}"
  fi
  return 0
}

# --- simulate -----------------------------------------------------------------------
# sleepwalk simulate rehearses a lid close and a lid open without doing either. The lid
# reads as closed for the sleep step, the Mac stays awake through the nap, and then the
# wake step runs as it does when the lid opens. It goes through the running watcher, so
# launchd's PATH and the watcher's privacy grants are part of the rehearsal; --direct runs
# the steps here instead. The handoff is real: the work is pushed and a cloud session
# starts. The Claude Code session that runs the rehearsal is left alone.
SIMULATE_USAGE="usage: sleepwalk simulate [--nap <seconds>] [--offline <seconds>] [--only <session>] [--direct] [--yes]"

# Prints the sessions a sleep would hand off right now, one "<id>\t<folder>" per line.
sleep_candidates() {
  local f
  for f in "$SESSIONS"/*.json; do
    [ -f "$f" ] || continue
    eligible "$f" || continue
    simulated_out "$(field "$f" .session_id)" && continue
    printf '%s\t%s\n' "$(field "$f" .session_id)" "$(field "$f" .cwd)"
  done
}

watcher_rehearses() {
  [ -z "${SLEEPWALK_NO_LAUNCHD:-}" ] && launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1 \
    && grep -q 'simulated sleep finished' "$HANDOFF_HOME/bin/sleepwatch" 2>/dev/null
}

# sim_step <sleep|wake> <watcher:0|1>: runs one step, through the watcher or here, and
# returns once it is done.
sim_step() {
  local step="$1" sig=SIGUSR1 wlog="$HANDOFF_HOME/sleepwatch.log" lines end
  if [ "$2" != 1 ]; then "$SELF" "$step"; return; fi
  [ "$step" = wake ] && sig=SIGUSR2
  lines="$(wc -l < "$wlog" 2>/dev/null | tr -d ' ')"
  launchctl kill "$sig" "gui/$(id -u)/$LABEL" || { echo "could not signal the watcher; running $step here"; "$SELF" "$step"; return; }
  if [ "$step" = sleep ]; then
    end=$(( $(now) + SLEEP_BUDGET + 15 ))
    until tail -n +"$(( ${lines:-0} + 1 ))" "$wlog" 2>/dev/null | grep -q 'simulated sleep finished'; do
      [ "$(now)" -lt "$end" ] || { echo "the watcher did not finish the sleep step"; return 1; }
      sleep 0.3
    done
  else
    # The wake step holds wake.lock while it runs.
    end=$(( $(now) + 5 ))
    until [ -d "$HANDOFF_HOME/wake.lock" ] || [ "$(now)" -ge "$end" ]; do sleep 0.2; done
    end=$(( $(now) + NETWORK_WAIT + 60 ))
    while [ -d "$HANDOFF_HOME/wake.lock" ] && [ "$(now)" -lt "$end" ]; do sleep 0.5; done
  fi
}

# countdown <seconds> <label>: waits, on one updating line when on a terminal; Enter ends it.
countdown() {
  local end=$(( $(now) + $1 )) left
  while [ "$(now)" -lt "$end" ]; do
    left=$(( end - $(now) ))
    if [ -t 1 ]; then printf '\r  %s %ss  (Enter to skip) \033[K' "$2" "$left"; fi
    if [ -t 0 ]; then read -r -t 1 _ && break; else sleep 1; fi
  done
  if [ -t 1 ]; then printf '\r\033[K'; fi
}

cmd_simulate() {
  local nap=60 offline=0 only="" direct=0 yes=0 watcher=0 t0 cands f sid st
  while [ $# -gt 0 ]; do
    case "$1" in
      --nap) nap="${2:-}"; shift ;;
      --offline) offline="${2:-}"; shift ;;
      --only) only="$(resolve_sid "${2:-}")" || exit 1; shift ;;
      --direct) direct=1 ;;
      --yes|-y) yes=1 ;;
      *) die "$SIMULATE_USAGE" ;;
    esac
    shift
  done
  case "$nap$offline" in ''|*[!0-9]*) die "$SIMULATE_USAGE" ;; esac
  [ "$offline" -le 600 ] || die "--offline is at most 600 seconds"
  mkdir -p "$HANDOFF_HOME"
  [ "$direct" = 0 ] && watcher_rehearses && watcher=1

  SIM_ONLY="$only"; SIM_SKIP="${CLAUDE_CODE_SESSION_ID:-}"
  cands="$(sleep_candidates)"
  if [ -z "$cands" ]; then
    echo "No busy session to hand off, so a lid close now would do nothing."
    echo "Start a turn in a Claude Code session in a git repository, then run this again."
    [ -n "$SIM_SKIP" ] && echo "(The session running this rehearsal always sits it out.)"
    return 0
  fi
  echo "Rehearsing a lid close. These sessions will really be pushed and handed to the cloud:"
  printf '%s\n' "$cands" | while IFS="$(printf '\t')" read -r sid f; do
    printf '  %s  %s\n' "$(printf '%s' "$sid" | cut -c1-8)" "$f"
  done
  echo "Then a ${nap}s nap$([ "$offline" -gt 0 ] && echo ", no network for ${offline}s after waking"), and a lid open, $([ "$watcher" = 1 ] && echo "through the running watcher" || echo "run here (--direct)")."
  if [ "$yes" != 1 ]; then
    [ -t 0 ] || die "add --yes to run without asking"
    printf 'Go ahead? [y/N] '
    read -r st
    case "$st" in y|Y|yes) ;; *) echo "Nothing done."; return 0 ;; esac
  fi

  cleanup_add "$SIMULATE"
  { printf 'SIM_LID=closed\n'; printf 'SIM_ONLY=%q\nSIM_SKIP=%q\n' "$SIM_ONLY" "$SIM_SKIP"; } > "$SIMULATE"
  t0="$(now)"
  log "simulate: lid close (nap ${nap}s, offline ${offline}s)"
  echo
  echo "Lid closed."
  sim_step sleep "$watcher"
  rm -f "$SIMULATE"
  for f in "$SESSIONS"/*.json; do
    [ -f "$f" ] || continue
    [ "$(field "$f" .handoff.at)" -ge "$t0" ] 2>/dev/null || continue
    sid="$(field "$f" .session_id | cut -c1-8)"
    case "$(field "$f" .handoff.status)" in
      cloud) printf '  %s  handed off after %ss: %s (branch %s)\n' "$sid" \
               "$(( $(field "$f" .handoff.at) - t0 ))" "$(field "$f" .handoff.url)" "$(field "$f" .handoff.branch)" ;;
      failed) printf '  %s  not handed off: %s\n' "$sid" "$(field "$f" .handoff.error)" ;;
    esac
  done

  echo
  countdown "$nap" "Asleep."
  if [ "$offline" -gt 0 ]; then
    printf 'SIM_OFFLINE_UNTIL=%s\n' "$(( $(now) + offline ))" > "$SIMULATE"
  fi
  log "simulate: lid open after $(( $(now) - t0 ))s"
  echo "Lid open."
  sim_step wake "$watcher"
  echo "Done in $(( $(now) - t0 ))s. The log is $LOG"
}

# --- install ------------------------------------------------------------------------
HOOK_EVENTS='["SessionStart","UserPromptSubmit","PreToolUse","Stop","SessionEnd"]'

settings_with_hooks() {
  # Removes any earlier sleepwalk hooks, then adds one per event when $1 is set.
  jq --arg cmd "$1" --argjson events "$HOOK_EVENTS" '
    def strip: map(.hooks |= map(select((.command // "") | contains("sleepwalk") | not)))
      | map(select(.hooks | length > 0));
    .hooks = (.hooks // {})
    | reduce $events[] as $e (.;
        .hooks[$e] = ((.hooks[$e] // []) | strip)
          + (if $cmd == "" then [] else [
              (if $e == "PreToolUse" then {matcher: "*"} else {} end)
              + {hooks: [{type: "command", command: $cmd, timeout: 10}]}
            ] end)
        | if .hooks[$e] == [] then del(.hooks[$e]) else . end)
    | if .hooks == {} then del(.hooks) else . end'
}

write_settings() {
  local cmd="$1" tmp
  mkdir -p "$(dirname "$CLAUDE_SETTINGS")"
  [ -f "$CLAUDE_SETTINGS" ] || echo '{}' > "$CLAUDE_SETTINGS"
  cp "$CLAUDE_SETTINGS" "$CLAUDE_SETTINGS.bak-sleepwalk"
  tmp="$CLAUDE_SETTINGS.$$.tmp"
  settings_with_hooks "$cmd" < "$CLAUDE_SETTINGS" > "$tmp" && mv "$tmp" "$CLAUDE_SETTINGS" \
    || { rm -f "$tmp"; die "could not update $CLAUDE_SETTINGS (backup at $CLAUDE_SETTINGS.bak-sleepwalk)"; }
}

cmd_install() {
  # --plugin: the Claude Code plugin ships the hooks itself, so leave settings.json alone.
  local src bin="$HANDOFF_HOME/bin" path_value plugin=0 stamp
  [ "${1:-}" = --plugin ] && plugin=1
  src="$(cd "$(dirname "$SELF")/.." && pwd)/src"
  [ -f "$src/sleepwatch.swift" ] || die "run install from a checkout or the plugin, not the installed copy"
  command -v jq >/dev/null || die "jq is required"
  command -v swiftc >/dev/null || die "swiftc is required (xcode-select --install)"
  mkdir -p "$bin" "$SESSIONS" "$(dirname "$PLIST")"
  cp "$SELF" "$bin/sleepwalk" && chmod +x "$bin/sleepwalk"
  # macOS remembers privacy answers per binary, so rebuild only when the source or the
  # compiler changes, and sign with a fixed identifier; otherwise every install asks again.
  stamp="$(cat "$src/sleepwatch.swift" | shasum | cut -c1-40) $(swiftc --version 2>&1 | head -1)"
  if [ ! -x "$bin/sleepwatch" ] || [ "$(cat "$bin/sleepwatch.stamp" 2>/dev/null)" != "$stamp" ]; then
    swiftc -O "$src/sleepwatch.swift" -o "$bin/sleepwatch" || die "could not build sleepwatch"
    codesign -f -s - --identifier "$LABEL.sleepwatch" "$bin/sleepwatch" 2>/dev/null \
      || die "could not sign sleepwatch"
    printf '%s' "$stamp" > "$bin/sleepwatch.stamp"
  fi
  [ -f "$CONFIG" ] || sed -n '/^# Defaults\./,/^CLAUDE_BIN=/p' "$SELF" \
    | sed -E '$d;s/^([A-Z_]+)="\$\{[A-Z_]+:-([^}]*)\}"/\1=\2/;s/^/# /' > "$CONFIG"

  path_value="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$bin/sleepwatch</string>
    <string>$bin/sleepwalk</string>
    <string>$((SLEEP_BUDGET + 3))</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>$path_value</string></dict>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$HANDOFF_HOME/sleepwatch.log</string>
  <key>StandardErrorPath</key><string>$HANDOFF_HOME/sleepwatch.log</string>
</dict>
</plist>
EOF
  if [ "$plugin" = 1 ]; then write_settings ""; else write_settings "\"$bin/sleepwalk\" hook"; fi
  if [ -z "${SLEEPWALK_NO_LAUNCHD:-}" ]; then
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
    launchctl bootstrap "gui/$(id -u)" "$PLIST" || die "launchctl could not load $PLIST"
  fi
  if [ "$plugin" = 1 ]; then echo "Installed the sleep watcher. The plugin provides the hooks."
  else echo "Installed. Hooks added to $CLAUDE_SETTINGS (backup alongside it)."; fi
  echo "Sessions that are already open pick up the hooks when they next start or resume."
  echo "Settings: $CONFIG    Log: $LOG"
}

cmd_uninstall() {
  [ -z "${SLEEPWALK_NO_LAUNCHD:-}" ] && launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
  rm -f "$PLIST"
  [ -f "$CLAUDE_SETTINGS" ] && write_settings ""
  rm -rf "${HANDOFF_HOME:?}/bin"
  echo "Uninstalled. Session records, config and log are left in $HANDOFF_HOME."
}

cmd_help() {
  cat <<'EOF'
sleepwalk: hand busy Claude Code sessions to the cloud when the Mac sleeps.

  install [--plugin] build the sleep watcher, load it with launchd, and add the hooks
                     to settings.json (--plugin: the plugin provides the hooks)
  uninstall          remove the sleep watcher and the hooks
  status [--all] [--json]
                     whether the watcher runs, and each session and its handoff
                     (--all: include old idle sessions; --json: for scripts)
  resume <session>   bring a handed-off session back here with claude --teleport
  release <session>  drop a handoff and unpause the local copy
  prune              forget old session records and leftover files (also runs hourly)
  trust <folder>     record Claude Code trust for this exact folder (see README)
  hotspot [name]     list saved iPhone hotspots, or choose the one to join when offline
  simulate [--nap <s>] [--offline <s>] [--only <session>] [--direct] [--yes]
                     rehearse a lid close, a nap and a lid open, for real but awake
  sleep [--dry-run]  what the watcher runs before sleep (dry run writes the brief only)
  wake               what the watcher runs after wake
  hook               what Claude Code runs for each hook event (reads JSON on stdin)

Sessions may be given as a unique prefix of the id. See README.md.
EOF
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  hook) cmd_hook "$@" ;;
  sleep) cmd_sleep "$@" ;;
  preflight) cmd_preflight "$@" ;;
  trust) cmd_trust "$@" ;;
  hotspot) cmd_hotspot "$@" ;;
  wake) cmd_wake "$@" ;;
  simulate) cmd_simulate "$@" ;;
  resume) cmd_resume "$@" ;;
  release) cmd_release "$@" ;;
  status) cmd_status "$@" ;;
  prune) cmd_prune "$@" ;;
  install) cmd_install "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command '$cmd' (sleepwalk help)" ;;
esac
